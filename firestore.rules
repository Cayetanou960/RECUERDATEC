rules_version = '2';

// Reglas de seguridad de RecuerdaTec.
// Pegar en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee y escribe su propio perfil.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Codigo de vinculacion (6 caracteres) -> id del espacio.
    // Cualquier usuario con sesion puede consultarlo; solo se puede crear, no cambiar.
    match /codigos/{codigo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    match /espacios/{espacio} {
      function esMiembro() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/espacios/$(espacio)/miembros/$(request.auth.uid));
      }

      // Cada usuario se anade a si mismo como miembro (tras conocer el codigo).
      match /miembros/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (request.auth.uid == uid || esMiembro());
      }

      // Datos del espacio (cuidador / paciente): solo los miembros.
      match /datos/{doc} {
        allow read, write: if esMiembro();
      }
    }
  }
}
